    "All your contacts get a text now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos tus contactos reciben un mensaje ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous vos contacts reçoivent un texto maintenant."
